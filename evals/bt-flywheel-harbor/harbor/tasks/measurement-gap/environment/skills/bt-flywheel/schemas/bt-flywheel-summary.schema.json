{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpguthrie/braintrust-flywheel-plugin/skills/bt-flywheel/schemas/bt-flywheel-summary.schema.json",
  "title": "bt-flywheel-summary",
  "type": "object",
  "required": [
    "contract_version",
    "run_id",
    "timestamp",
    "mode",
    "goal",
    "phases_run",
    "outcome",
    "severity",
    "blocking",
    "confidence",
    "summary",
    "findings",
    "changes",
    "verification",
    "regressions",
    "links",
    "artifacts",
    "next_steps"
  ],
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "bt-flywheel-handoff/v1"
    },
    "run_id": {
      "type": "string",
      "description": "Stable run identifier for logs, dedupe, and caller correlation."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO8601 timestamp for the flywheel run."
    },
    "mode": {
      "type": "string",
      "enum": ["interactive", "autonomous"]
    },
    "goal": {
      "type": "string"
    },
    "phases_run": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["orient", "discover", "diagnose", "improve", "verify_decide"]
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["healthy", "improved", "needs_work", "blocked", "no_convergence"]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "blocking": {
      "type": "boolean"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changes": {
      "type": "object",
      "required": ["agent", "measurement", "datasets", "instrumentation"],
      "additionalProperties": true,
      "properties": {
        "agent": {
          "type": "array",
          "items": { "type": "string" }
        },
        "measurement": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scorers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Deprecated alias for measurement. Present only for legacy callers."
        },
        "datasets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "instrumentation": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "metric_delta", "regression_count"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_run", "smoke_passed", "full_passed", "failed", "inconclusive"]
        },
        "baseline_experiment_id": { "type": ["string", "null"] },
        "baseline_experiment_url": { "type": ["string", "null"] },
        "new_experiment_id": { "type": ["string", "null"] },
        "new_experiment_url": { "type": ["string", "null"] },
        "metric_delta": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trace_id", "score", "url"],
        "additionalProperties": true,
        "properties": {
          "trace_id": { "type": "string" },
          "score": { "type": "number" },
          "url": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "role", "label"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["experiment", "trace", "query", "dataset", "function", "document", "external"]
          },
          "role": { "type": "string" },
          "label": { "type": "string" },
          "id": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["summary_json", "narrative_markdown", "curated_dataset_rows", "eval_output", "patch", "log", "other"]
          },
          "path": { "type": "string" },
          "label": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "intent",
          "priority",
          "blocking",
          "requires_human_review",
          "title",
          "body_markdown",
          "idempotency_key"
        ],
        "additionalProperties": true,
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "no_action",
              "review_change",
              "investigate",
              "label_data",
              "rerun",
              "notify",
              "block_release",
              "rollback"
            ]
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high"]
          },
          "blocking": { "type": "boolean" },
          "requires_human_review": { "type": "boolean" },
          "title": { "type": "string" },
          "body_markdown": { "type": "string" },
          "suggested_destination": {
            "type": "string",
            "enum": [
              "local_summary",
              "code_review",
              "issue_tracker",
              "chat",
              "release_gate",
              "scheduler",
              "app_ui",
              "external_system",
              "none"
            ]
          },
          "link_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "artifact_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "idempotency_key": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
